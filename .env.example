
NODE_ENV=development

# Which parts of the service run in this process (comma separated): api, consumer, worker
# Default: all three. In production run separate containers, e.g. SERVICE_ROLES=worker
SERVICE_ROLES=api,consumer,worker

DATABASE_URL=postgres://notification_service_user:your_notification_service_password@localhost:5432/gridx_db?sslmode=disable&search_path=notification_data
DOCKER_POSTGRES_URL=postgres://notification_service_user:your_notification_service_password@postgres:5432/gridx_db?sslmode=disable&search_path=notification_data

REDIS_URL=redis://localhost:6379

# HTTP server (health, metrics, provider webhooks)
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

SHUTDOWN_TIMEOUT_MS=8000
