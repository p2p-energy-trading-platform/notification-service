
NODE_ENV=development

# Which parts of the service run in this process (comma separated): api, consumer, worker
# Default: all three. In production run separate containers, e.g. SERVICE_ROLES=worker
SERVICE_ROLES=api,consumer,worker

# HTTP server (health, metrics, provider webhooks)
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
