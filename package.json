{
  "name": "notification-service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
  "dev": "tsx watch src/main.ts",
  "build": "tsc -p tsconfig.json",
  "start": "node dist/main.js",
  "typecheck": "tsc --noEmit",
  "lint": "oxlint -D correctness -D suspicious --vitest-plugin --deny-warnings src tests",
  "lint:fix": "oxlint -D correctness -D suspicious --vitest-plugin --fix src tests",
  "format": "oxfmt --write src tests",
  "format:check": "oxfmt --check src tests",
  "test": "vitest run",
  "test:watch": "vitest",
  "check": "npm run lint && npm run typecheck && npm run test && npm run build"
},
"engines": { "node": ">=24" },

  "repository": {
    "type": "git",
    "url": "git+https://github.com/p2p-energy-trading-platform/notification-service.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/p2p-energy-trading-platform/notification-service/issues"
  },
  "homepage": "https://github.com/p2p-energy-trading-platform/notification-service#readme",
  "dependencies": {
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "dotenv-cli": "^11.1.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
